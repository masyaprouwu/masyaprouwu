local function getCenter()
	if isStaticMode and waypointPart then
		return waypointPart.Position
	elseif rootPart then
		return rootPart.Position
	end
	return nil
end

--// RESET FUNCTION 🔥
local function resetScan()
	if sound then
		sound:Stop()
	end

	isPlaying = false
	task.wait(0.05)
end

btnReset.MouseButton1Click:Connect(resetScan)

--// CHECK PLAYERS
local function check()
	local center = getCenter()
	if not center then return end

	local radius = detectionRadius
	local found = false

	for _,p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local d = (p.Character.HumanoidRootPart.Position - center).Magnitude

			if d <= radius then
				found = true
				break
			end
		end
	end

	if found then
		if not isPlaying then
			isPlaying = true
			sound:Play()
		end
	else
		if isPlaying then
			isPlaying = false
			sound:Stop()
		end
	end
end

