local SpecialPlayerColors = {
    ["drdrdrj2"] = {Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 100, 0)},  -- ярко-зелёный и тёмно-зелёный
    ["very5128"] = {Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 100, 0)}
