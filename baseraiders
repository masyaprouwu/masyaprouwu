    print("Body Highlight initializing...")
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            OnPlayerAdded(player)
        end
    end
    
    Players.PlayerAdded:Connect(OnPlayerAdded)
    
    CreateGUI()
    
    print("Body Highlight loaded! Press F5 to toggle GUI.")
    print("Squares appear on ALL players when enabled and NEVER disappear")
    print("Special players 'drdrdrj2' and 'very5128' have animated green highlights (bright green <-> dark green)")
end

