corner.CornerRadius = UDim.new(1, 0)
corner.Parent = circle

-- Обводка круга
local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Transparency = 0
stroke.Parent = circle

-- Обновление позиции круга
local function updateCirclePosition()
    mousePos = UIS:GetMouseLocation()
    circle.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
end

-- Текст для сообщений
local msg = Instance.new("TextLabel")
msg.Parent = gui
msg.AnchorPoint = Vector2.new(1, 1)
msg.Position = UDim2.new(1, -10, 1, -10)
msg.Size = UDim2.new(0, 250, 0, 30)
msg.BackgroundTransparency = 1
msg.TextScaled = true
msg.Font = Enum.Font.SourceSansBold
msg.TextColor3 = Color3.fromRGB(0, 255, 0)
msg.TextStrokeTransparency = 0.5
msg.Visible = false
msg.ZIndex = 20

local function showMessage(text, duration)
    msg.Text = text
    msg.Visible = true
    task.delay(duration, function() msg.Visible = false end)
end

--// ПОИСК ЦЕЛИ ВНУТРИ FOV (с центром в позиции мыши)
local function getClosestTargetInFOV()
    local closestPart = nil
    local shortestDist = FOV_RADIUS  -- Радиус поиска
    
    -- Центр поиска - позиция мыши
    local center = mousePos
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                -- Выбираем часть тела
                local head = plr.Character:FindFirstChild("Head")
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                local target = nil
                
                if aimPartType == "Head" then
                    target = head or hrp
                else
                    target = hrp or head
                end
                
                if target then
                    local pos, onScreen = Camera:WorldToViewportPoint(target.Position)
                    if onScreen then
                        local screenPos = Vector2.new(pos.X, pos.Y)
                        local dist = (screenPos - center).Magnitude
                        
                        if dist <= shortestDist then
                            closestPart = target
                            shortestDist = dist
                        end
                    end
                end
            end
        end
    end
    
    return closestPart
end

--// ОБРАБОТКА ВВОДА
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    -- Переключение части тела (Голова/Торс)
    if input.KeyCode == SWITCH_TARGET_KEY then
        aimPartType = (aimPartType == "Head") and "Torso" or "Head"
        showMessage("Цель: " .. aimPartType, 1)
    end
    
    -- Активация аима по ПРАВОЙ КНОПКЕ МЫШИ (MouseButton2)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aiming = true
        currentTargetPart = getClosestTargetInFOV()
        -- Меняем цвет круга при активации
        stroke.Color = Color3.fromRGB(255, 0, 0)
    end
end)

UIS.InputEnded:Connect(function(input)
    -- Деактивация при отпускании правой кнопки
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aiming = false
        currentTargetPart = nil
        -- Возвращаем цвет круга
        stroke.Color = Color3.fromRGB(255, 255, 255)
        
        -- Включаем авто-поворот обратно
        local _, hum = getCharacter()
        if hum then hum.AutoRotate = true end
    end
end)

-- Обновление позиции круга каждый кадр
RunService.RenderStepped:Connect(function()
    updateCirclePosition()
end)

--// ОСНОВНОЙ ЦИКЛ АИМА (резкое прицеливание как во 2-м скрипте)
RunService.RenderStepped:Connect(function(dt)
    if not aiming then return end
    
    -- Если нет цели или цель исчезла - ищем новую
    if not currentTargetPart or not currentTargetPart.Parent then
        currentTargetPart = getClosestTargetInFOV()
        return
    end
    
    local hrp, hum = getCharacter()
    if not hrp or not hum then return end
    
    -- РЕЗКОЕ прицеливание (без плавности)
    local targetPos = currentTargetPart.Position
    
    -- 1. Поворот камеры на цель
    local camPos = Camera.CFrame.Position
    Camera.CFrame = CFrame.new(camPos, targetPos)
    
    -- 2. Поворот персонажа за целью
    hum.AutoRotate = false
    local lookPos = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
    hrp.CFrame = CFrame.new(hrp.Position, lookPos)
end)

