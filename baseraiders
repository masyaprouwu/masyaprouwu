    FOV РАДИУС ФИКСИРОВАН: 80 (нельзя изменить)
]]

--// НАСТРОЙКИ
local FOV_RADIUS = 80  -- ФИКСИРОВАННЫЙ РАЗМЕР (нельзя изменить)

local SWITCH_TARGET_KEY = Enum.KeyCode.BackSlash -- Сменить часть тела

local AIM_SPEED = 35  -- Скорость наведения камеры
local ROTATE_SPEED = 41 -- Скорость поворота персонажа

--// СЕРВИСЫ
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer

--// СОСТОЯНИЕ
local aiming = false
local currentTargetPart = nil
local aimPartType = "Torso"  -- Можно переключать на "Torso"
local mousePos = Vector2.new(0, 0)

--// ФУНКЦИЯ ПОЛУЧЕНИЯ ПЕРСОНАЖА
local function getCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    return char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")
end

--// GUI
local gui = Instance.new("ScreenGui")
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
