-- Обработчики персонажей
local function OnCharacterAdded(character)
    if HighlightSettings.Active then
        task.wait(0.2)
        
        local player = Players:GetPlayerFromCharacter(character)
        if player and player ~= LocalPlayer then
            task.spawn(function()
                CreateBodyHighlight(character)
            end)
            
            if HighlightSettings.ShowSquare then
                task.spawn(function()
                    CreateSquare(player, character)
                end)
            end
            
            -- Запускаем анимацию для специального игрока
            if IsSpecialPlayer(player) and not SpecialAnimations[player] then
                local connection
                connection = RunService.RenderStepped:Connect(function()
                    if HighlightSettings.Active and player.Character and player.Character.Parent then
                        UpdateHighlightColors(player.Character, player)
                    elseif connection then
                        connection:Disconnect()
                    end
                end)
                SpecialAnimations[player] = connection
            end
        end
    end
end

local function OnCharacterRemoving(character)
    local player = Players:GetPlayerFromCharacter(character)
    if player then
        if BodyHighlights[character] then
            for _, highlight in pairs(BodyHighlights[character]) do
                pcall(function() highlight:Destroy() end)
            end
            BodyHighlights[character] = nil
        end
        
        -- Останавливаем анимацию для специального игрока
        if SpecialAnimations[player] then
            pcall(function() SpecialAnimations[player]:Disconnect() end)
            SpecialAnimations[player] = nil
        end
    end
end

local function OnPlayerAdded(player)
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(OnCharacterAdded)
        player.CharacterRemoving:Connect(OnCharacterRemoving)
        
        if player.Character then
            task.wait(0.2)
            OnCharacterAdded(player.Character)
        end
    end
end

-- Горячие клавиши
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.F5 then
        local gui = CoreGui:FindFirstChild("BodyHighlightGUI") or 
                    (LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("BodyHighlightGUI"))
        
        if gui and gui:FindFirstChild("MainFrame") then
            gui.MainFrame.Visible = not gui.MainFrame.Visible
        elseif not GuiCreated then
            CreateGUI()
        end
    end
    
    if input.KeyCode == Enum.KeyCode.R then
        if HighlightSettings.Active then
            HighlightAllPlayers()
            print("Highlights reset by hotkey!")
        end
    end
end)

