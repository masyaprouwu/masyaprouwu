			StartPos.Y.Scale,
			StartPos.Y.Offset + Delta.Y
		)
	end
end)

-- ESP

local function AddHighlight(Model)
	if not ESPEnabled then
		return
	end

	if Highlights[Model] then
		return
	end

	local Color = TurretColors[Model.Name]
	if not Color then
		return
	end

	local Highlight = Instance.new("Highlight")
	Highlight.Name = "TurretESP"
	Highlight.FillColor = Color
	Highlight.OutlineColor = Color3.new(1,1,1)
	Highlight.FillTransparency = 0.5
	Highlight.OutlineTransparency = 0
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.Adornee = Model
	Highlight.Parent = Model

	Highlights[Model] = Highlight
end

local function RemoveAllHighlights()
	for _, Highlight in pairs(Highlights) do
		if Highlight then
			Highlight:Destroy()
		end
	end

	table.clear(Highlights)
end

local function ScanTurrets()
	if Scanning then
		return
	end

	Scanning = true

	task.spawn(function()

		local Count = 0

		for _, Obj in ipairs(TycoonsFolder:GetDescendants()) do

			if not ESPEnabled then
				break
			end

			if Obj:IsA("Model") and TurretColors[Obj.Name] then
				AddHighlight(Obj)
			end

			Count += 1

			if Count >= 250 then
				Count = 0
				task.wait()
			end
		end

		Scanning = false
	end)
end

TycoonsFolder.DescendantAdded:Connect(function(Obj)
	if not ESPEnabled then
		return
	end

	if Obj:IsA("Model") and TurretColors[Obj.Name] then
		AddHighlight(Obj)
	end
end)

TycoonsFolder.DescendantRemoving:Connect(function(Obj)
	if Highlights[Obj] then
		Highlights[Obj] = nil
	end
end)

Toggle.MouseButton1Click:Connect(function()

	ESPEnabled = not ESPEnabled

	if ESPEnabled then
		Toggle.Text = "ESP: ON"
		Toggle.BackgroundColor3 = Color3.fromRGB(50, 200, 50)

		ScanTurrets()
	else
		Toggle.Text = "ESP: OFF"
		Toggle.BackgroundColor3 = Color3.fromRGB(200, 50, 50)

		RemoveAllHighlights()
	end
end)

