local BodyHighlights = {}
local Squares = {}
local AutoRefreshConnection = nil
local GuiCreated = false

-- Функция получения цвета команды игрока
local function GetTeamColor(player)
    if player and player.Team then
        return player.Team.TeamColor.Color
    end
    return HighlightSettings.Color
end

-- Функция проверки, является ли игрок специальным
local function IsSpecialPlayer(player)
    return player and SpecialPlayerColors[player.Name] ~= nil
end

-- Функция для циклической анимации цвета (возвращает текущий цвет)
local function GetAnimatedColor(player, time)
    if IsSpecialPlayer(player) then
        local colors = SpecialPlayerColors[player.Name]
        -- Цикл: sin от 0 до 2π, значение от 0 до 1, затем обратно
        local t = (time % 4) / 2  -- полный цикл за 4 секунды (2 сек туда, 2 сек обратно)
        if t > 1 then t = 2 - t end  -- отражаем для плавного перехода туда-обратно
        -- Плавная интерполяция
        return colors[1]:Lerp(colors[2], t)
    end
    return nil
end

-- Функция получения цвета для игрока (с учётом анимации)
local function GetPlayerColor(player, character)
    local currentTime = tick()
    local animatedColor = GetAnimatedColor(player, currentTime)
    
    if animatedColor then
        return animatedColor
    elseif HighlightSettings.UseTeamColor then
        return GetTeamColor(player)
    elseif HighlightSettings.UsePlayerColor and character and character:FindFirstChild("Head") then
        return character.Head.Color
    else
        return HighlightSettings.Color
    end
end

-- Функция определения типа аватара
local function GetAvatarType(character)
    if character and character:FindFirstChild("Humanoid") then
        return character.Humanoid.RigType == Enum.HumanoidRigType.R6 and "R6" or "R15"
    end
    return "Unknown"
end

-- Функция обновления цвета существующей подсветки (для анимации)
local function UpdateHighlightColors(character, player)
    if not character or not player then return end
    
    local highlights = BodyHighlights[character]
    if not highlights then return end
    
    local currentColor = GetPlayerColor(player, character)
    
    for _, highlight in pairs(highlights) do
        if highlight and highlight.Parent then
            pcall(function()
                highlight.Color3 = currentColor
            end)
        end
    end
    
    -- Обновляем цвет квадрата если он есть
    if Squares[player] and Squares[player].Parent then
        local squareFrame = Squares[player]:FindFirstChild("Square")
        if squareFrame then
            pcall(function()
                squareFrame.BackgroundColor3 = currentColor
                local gradient = squareFrame:FindFirstChild("UIGradient")
                if gradient then
                    gradient.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, currentColor),
                        ColorSequenceKeypoint.new(1, currentColor:Lerp(Color3.fromRGB(255, 255, 255), 0.3))
                    })
                end
                local stroke = squareFrame:FindFirstChild("UIStroke")
                if stroke then
                    stroke.Color = currentColor:Lerp(Color3.fromRGB(255, 255, 255), 0.5)
                end
            end)
        end
    end
end

-- Запуск анимации для специальных игроков
local function StartSpecialAnimations()
    -- Останавливаем старые анимации
    for _, connection in pairs(SpecialAnimations) do
        pcall(function() connection:Disconnect() end)
    end
    SpecialAnimations = {}
    
    -- Запускаем новую анимацию для каждого специального игрока
    for _, player in ipairs(Players:GetPlayers()) do
        if IsSpecialPlayer(player) and player.Character then
            local connection
            connection = RunService.RenderStepped:Connect(function()
                if HighlightSettings.Active and player.Character and player.Character.Parent then
                    UpdateHighlightColors(player.Character, player)
                elseif connection then
                    connection:Disconnect()
                end
            end)
            SpecialAnimations[player] = connection
        end
    end
end

-- Функция создания квадратной метки
local function CreateSquare(player, character)
    if not character or not HighlightSettings.ShowSquare or not HighlightSettings.Active then return nil end
    
    task.wait(0.1)
    
    local head = character:FindFirstChild("Head")
    local attachPart = head or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso") or character:FindFirstChildWhichIsA("BasePart")
    
    if not attachPart then 
        print("No attachment part found for player:", player and player.Name)
        return nil
    end
    
    if Squares[player] then
        pcall(function() 
            if Squares[player] and Squares[player].Parent then
                Squares[player]:Destroy()
            end
        end)
    end
    
    local squareColor = GetPlayerColor(player, character)
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TeamSquare"
    billboard.Adornee = attachPart
    billboard.Size = UDim2.new(0, 25, 0, 25)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    billboard.Enabled = true
    billboard.Parent = character
    
    local square = Instance.new("Frame")
    square.Name = "Square"
    square.Size = UDim2.new(1, 0, 1, 0)
    square.BackgroundColor3 = squareColor
    square.BackgroundTransparency = 0.2
    square.Parent = billboard
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = squareColor:Lerp(Color3.fromRGB(255, 255, 255), 0.5)
    stroke.Parent = square
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = square
    
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, squareColor),
        ColorSequenceKeypoint.new(1, squareColor:Lerp(Color3.fromRGB(255, 255, 255), 0.3))
    })
    gradient.Rotation = 45
    gradient.Parent = square
    
    Squares[player] = billboard
    print("Square created for player:", player and player.Name or "Unknown")
    
    return billboard
end

-- Функция создания подсветки тела
local function CreateBodyHighlight(character)
    if not character or not HighlightSettings.Active then return end
    
    local player = Players:GetPlayerFromCharacter(character)
    if not player or player == LocalPlayer then return end
    
    local avatarType = GetAvatarType(character)
    if (avatarType == "R6" and not HighlightSettings.HighlightR6) or
        (avatarType == "R15" and not HighlightSettings.HighlightR15) then
        return
    end
    
    if BodyHighlights[character] then
        for _, highlight in pairs(BodyHighlights[character]) do
            if highlight then 
                pcall(function() highlight:Destroy() end)
            end
        end
    end
    
    local partsToHighlight = avatarType == "R6" and R6BodyParts or R15BodyParts
    local highlights = {}
    
    local color = GetPlayerColor(player, character)
    
    for _, partName in pairs(partsToHighlight) do
        local part = character:FindFirstChild(partName)
        if part then
            pcall(function()
                local highlight = Instance.new("BoxHandleAdornment")
                highlight.Name = "BodyHighlight"
                highlight.Adornee = part
                highlight.AlwaysOnTop = true
                highlight.ZIndex = 5
                highlight.Size = part.Size * 1.05
                highlight.Transparency = HighlightSettings.Transparency
                highlight.Color3 = color
                highlight.Visible = true
                highlight.Parent = part
                table.insert(highlights, highlight)
            end)
        end
    end
    
    BodyHighlights[character] = highlights
end

-- Функция создания подсветки и квадрата для ВСЕХ игроков
local function HighlightAllPlayers()
    print("Starting to highlight ALL players...")
    
    for character, highlights in pairs(BodyHighlights) do
        if highlights then
            for _, highlight in pairs(highlights) do
                pcall(function() highlight:Destroy() end)
            end
        end
    end
    BodyHighlights = {}
    
    for player, square in pairs(Squares) do
        pcall(function() 
            if square and square.Parent then
                square:Destroy()
            end
        end)
    end
    Squares = {}
    
    if not HighlightSettings.Active then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            
            task.spawn(function()
                CreateBodyHighlight(character)
            end)
            
            if HighlightSettings.ShowSquare then
                task.spawn(function()
                    CreateSquare(player, character)
                end)
            end
        end
    end
    
    -- Запускаем анимации для специальных игроков
    StartSpecialAnimations()
    
    print("Highlighting complete! Total players highlighted: " .. #Players:GetPlayers() - 1)
end

-- Запуск автообновления
local function StartAutoRefresh()
    if AutoRefreshConnection then
        AutoRefreshConnection:Disconnect()
    end
    
    AutoRefreshConnection = RunService.Heartbeat:Connect(function()
        if tick() % 3 < 0.1 and HighlightSettings.Active then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    if not BodyHighlights[player.Character] then
                        CreateBodyHighlight(player.Character)
                    end
                    
                    if HighlightSettings.ShowSquare and not Squares[player] then
                        CreateSquare(player, player.Character)
                    end
                    
                    -- Обновляем цвета для специальных игроков при необходимости
                    if IsSpecialPlayer(player) then
                        UpdateHighlightColors(player.Character, player)
                    end
                end
            end
        end
    end)
end

-- Остановка автообновления
local function StopAutoRefresh()
    if AutoRefreshConnection then
        AutoRefreshConnection:Disconnect()
        AutoRefreshConnection = nil
    end
    for _, connection in pairs(SpecialAnimations) do
        pcall(function() connection:Disconnect() end)
    end
    SpecialAnimations = {}
end

